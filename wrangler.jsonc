{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandarc-manual",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  // The script only repairs redirect Location headers (see src/index.js);
  // run_worker_first is required because trailing-slash 307s are generated
  // during asset matching, which otherwise bypasses the script entirely.
  "main": "src/index.js",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
